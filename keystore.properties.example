# 프로젝트 루트에 keystore.properties 로 복사해서 쓴다.
# ★ 반드시 .gitignore 에 추가할 것. 커밋되면 앱을 통째로 탈취당한다.
storeFile=../yeobaek-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=yeobaek
keyPassword=여기에_키_비밀번호

# 키스토어 생성 (터미널에서 1회):
#   keytool -genkeypair -v -keystore yeobaek-release.jks \
#     -alias yeobaek -keyalg RSA -keysize 4096 -validity 10000
#
# ★ 이 .jks 파일과 비밀번호를 잃어버리면 앱 업데이트를 영원히 못 올린다.
#   (Play 앱 서명을 쓰면 복구 가능하지만, 업로드 키는 별도 재등록 절차가 필요하다)
#   클라우드 드라이브 + USB 두 곳에 백업할 것.
