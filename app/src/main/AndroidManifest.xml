<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 인터넷 권한 (여백 FastAPI 서버 통신용) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Yeobaek">
        <!-- 지도 키: local.properties 의 MAPS_API_KEY 로 주입(빌드 시 치환).
             값이 없으면 build.gradle 의 기본값 사용. 본인 키는 local.properties 에만 두세요(깃 추적 X). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <!-- ── 여백(Yeobaek) 코스 플래너 — View/XML 화면 ── -->
        <activity
            android:name=".yeobaek.ui.YeobaekHomeActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".yeobaek.ui.SearchActivity" android:exported="false" />
        <activity android:name=".yeobaek.ui.DistrictActivity" android:exported="false" />
        <activity android:name=".yeobaek.ui.PlannerActivity" android:exported="false" />
        <activity android:name=".yeobaek.ui.AlternativesActivity" android:exported="false" />
        <activity android:name=".yeobaek.ui.CardActivity" android:exported="false" />

        <!-- ── 여백 Compose 레이어(슬레이트 틸 리디자인) ── -->
        <!-- 기존 View 화면과 공존. 데모에서 바로 열 수 있도록 별도 런처로 노출. -->
        <activity
            android:name=".yeobaek.compose.YeobaekComposeActivity"
            android:label="여백 ✦"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
