<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 인터넷 권한 (서버 통신용) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 위치 권한 (GPS용) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- <manifest> 내 권한 블록에 추가 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />   <!-- API 31+ 런타임 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />  <!-- API 29+ 런타임 -->

    <!-- BLE Passive Scanning 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="s" />
    <!-- EN방식 회전 임시 ID 광고 송출용 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="s" />

    <!-- 백그라운드 위치 추적용 포그라운드 서비스 (화면 꺼져도 수집 유지) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 포그라운드 서비스 알림 표시 (33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CrowdMap">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCzG9WISxXy7e8EZ-YCf5XtVbpSfX4V9SA"/>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- ── 여백(Yeobaek) 코스 플래너 3화면 ── -->
        <!-- 홈: CrowdMap 을 건드리지 않도록 별도 런처("여백")로 노출 -->
        <activity
            android:name=".yeobaek.ui.YeobaekHomeActivity"
            android:label="여백"
            android:theme="@style/Theme.Yeobaek"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".yeobaek.ui.SearchActivity"
            android:theme="@style/Theme.Yeobaek" android:exported="false" />
        <activity android:name=".yeobaek.ui.PlannerActivity"
            android:theme="@style/Theme.Yeobaek" android:exported="false" />
        <activity android:name=".yeobaek.ui.AlternativesActivity"
            android:theme="@style/Theme.Yeobaek" android:exported="false" />
        <activity android:name=".yeobaek.ui.CardActivity"
            android:theme="@style/Theme.Yeobaek" android:exported="false" />
    </application>

</manifest>