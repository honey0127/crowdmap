<?xml version="1.0" encoding="utf-8"?>
<!--
    릴리스(프로덕션) 기본값: 평문 HTTP 전면 차단.
    실서버는 반드시 https 여야 한다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
