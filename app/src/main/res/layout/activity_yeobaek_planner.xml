<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ye_background">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/ye_primary_container"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/planner_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="코스"
                android:textColor="@color/ye_on_primary_container"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/planner_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/ye_on_primary_container"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/planner_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/ye_on_primary_container"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 실시간 급증 알림(모듈4) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/planner_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardElevation="0dp"
        app:strokeColor="@color/ye_lv4"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/ye_surface"
        app:cardCornerRadius="16dp">

        <TextView
            android:id="@+id/planner_alert_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text=""
            android:textColor="@color/ye_lv4"
            android:textStyle="bold"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/planner_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
