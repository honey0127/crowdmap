<?xml version="1.0" encoding="utf-8"?>
<!-- 위치 기준 코스 플래너: 기준 위치 선택 → 주변 명소 라인업 담기 → 코스 만들기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ye_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코스 플래너"
            style="@style/Ye.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="기준 위치를 고르면 그 주변 명소로 하루 코스를 만들어요"
            android:textColor="@color/ye_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 기준 위치 선택 바 (탭하면 장소 검색으로 위치 변경) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/center_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/ye_outline"
        app:cardBackgroundColor="@color/ye_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="📍"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="기준 위치"
                    android:textColor="@color/ye_on_surface_variant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/center_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="위치를 선택하세요"
                    android:textColor="@color/ye_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="변경"
                android:textColor="@color/ye_primary"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 빠른 선택: 대표 지역 프리셋 (가로 스크롤) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="20dp"
        android:text="빠른 선택"
        style="@style/Ye.Section" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/district_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- 선택 위치 소개 / 반경 안내 -->
    <TextView
        android:id="@+id/district_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:text=""
        android:textColor="@color/ye_on_surface_variant"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lineup_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/lineup_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lineup_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="주변에 등록된 명소가 없어요"
            android:textColor="@color/ye_on_surface_variant"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 하단 바: 내 코스 개수 + 코스 만들기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ye_surface"
        android:elevation="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/course_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내 코스 0곳"
            android:textColor="@color/ye_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_make_course"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="코스 만들기"
            android:textSize="16sp"
            android:paddingHorizontal="28dp"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/course_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
</LinearLayout>
