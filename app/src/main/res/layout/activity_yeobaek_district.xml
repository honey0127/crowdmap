<?xml version="1.0" encoding="utf-8"?>
<!-- 코스 플래너: 지역구 선택 → 명소 라인업 담기 → 코스 만들기 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ye_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코스 플래너"
            style="@style/Ye.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="지역을 고르면 명소 라인업을 담아 하루 코스를 만들어요"
            android:textColor="@color/ye_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 지역구 칩 (가로 스크롤) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/district_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- 선택 지역구 소개 -->
    <TextView
        android:id="@+id/district_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="@color/ye_on_surface_variant"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lineup_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/lineup_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lineup_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="이 지역엔 등록된 명소가 아직 적어요.\n지도 화면에서 위치를 직접 담아보세요."
            android:textColor="@color/ye_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 하단 바: 내 코스 개수 + 코스 만들기 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ye_surface"
        android:elevation="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/course_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내 코스 0곳"
            android:textColor="@color/ye_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_make_course"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="코스 만들기"
            android:textSize="16sp"
            android:paddingHorizontal="28dp"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/course_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
</LinearLayout>
