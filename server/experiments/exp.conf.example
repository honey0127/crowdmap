# 실험 설정 — exp.conf 로 복사해 고친다 (exp.conf 는 기계별이라 git 에 올리지 않는다).
# 다른 경로의 설정을 쓰려면: EXP_CONF=/path/to/conf ./run_all.sh
# 값이 없는 변수는 lib.sh / plan.py 의 기본값을 쓴다. 아래 값이 그 기본값이다.

# ── 서버 (물리 4코어 VM) ───────────────────────────────────────────────
# 비우면 같은 기계에서 서버를 띄운다(스모크 테스트용). 실제 실험은 서버 VM 을 ssh 로 제어한다:
# 키 인증(BatchMode)이 되어야 하고, 서버 VM 에 실험 빌드가 있어야 한다.
#   cmake -S . -B build-exp -DCMAKE_BUILD_TYPE=Release -DCROWDMAP_EXPERIMENT=ON && cmake --build build-exp -j
SERVER_SSH=""                               # 예: ubuntu@10.0.0.2
SERVER_HOST=127.0.0.1                       # 부하 생성기가 접속할 서버 주소 (예: 10.0.0.2)
SERVER_PORT=8765
SERVER_BIN=""                               # 서버 기계의 실험 빌드 경로 (비우면 ../build-exp/crowdmap_server)
SERVER_WORKDIR=/tmp/crowdmap-exp            # 서버 기계에서 실행별 로그·CSV 를 쓸 곳 (실행마다 지움)
# 모든 실행에 공통인 서버 환경변수. 외부 API 는 가짜(100ms, v4 실측 98ms)로 고정해 재현성을 지킨다.
SERVER_ENV_COMMON="FAKE_API_MS=100"
# 서버 fd 한도 점검: 서버 hard nofile ≥ LG_CONNS + SERVER_FD_QUEUE + 1000 이어야 한다.
# 큐에 쌓인 작업마다 dup 한 fd 를 하나씩 쥐므로, 동적 상한 최대(2^17)까지 쌓일 수 있다고 보고 잡았다.
# 한도를 못 올리는 기계면 줄이되, 큐가 그보다 깊어지면 dup 실패가 shed 로 섞인다.
SERVER_FD_QUEUE=131072
# 같은 기계 스모크 예: 리액터 CPU0, 워커 CPU1·2, 생성기 CPU3
#   SERVER_ENV_COMMON="FAKE_API_MS=100 REACTOR_CPU=0 WORKER_CPUS=1,2"
#   LOADGEN_TASKSET="taskset -c 3"

# ── 부하 생성기 (별도 VM) ───────────────────────────────────────────────
LOADGEN_BIN=""                              # 비우면 ../build-exp/crowdmap_loadgen
LOADGEN_TASKSET=""
LG_CONNS=20000        # 연결 8개 × 2만 = 16만 > 최대 유입(초당 6만 × 1초)의 2.7배
LG_THREADS=4
LG_OUTSTANDING=8
WARMUP=10             # 초
DURATION=75           # 버스트 주기 25초의 3배
TIMEOUT=3             # 앱 READ_TIMEOUT
WORK_US=10000         # COMPLEX 합성 작업량(µs)
SYNC_WIDTH=3          # 몰림 폭(초, v4 실측)
SYNC_PERIOD=25        # 몰림 주기(초, v4 실측)
Q_THRESHOLD_MS=50     # 대기 목표 — q 가 이 값을 넘은 비율을 센다(실험 C 판정)
SEED_BASE=1           # 반복 r 의 생성기 시드 = SEED_BASE×1000 + r (같은 반복 안의 조건은 같은 도착 순서)
REACTOR_FRAC=0.8      # 최대 유입이 리액터 한계 × 이 값을 넘는 조건은 제외(워커가 아니라 리액터를 재게 됨)
COOLDOWN_S=3          # 실행 사이 쉬는 시간
MAX_CONSEC_FAIL=3     # 연속 실패가 이만큼이면 환경 문제로 보고 중단
GENLAG_DISCARD_MS=10  # 생성기 송신 지연 p99 가 이보다 큰 실행은 생성기 포화로 보고 평균에서 뺀다(보고서에 목록)

# ── 결과 ───────────────────────────────────────────────────────────────
RESULTS_DIR=""                              # 비우면 ../results
CALIB_FILE=""                               # 비우면 $RESULTS_DIR/calib.env

# ── 실험 0: 보정 ────────────────────────────────────────────────────────
CAL_WORKER_CPU=1                            # SIMPLE·COMPLEX 처리 시간을 잴 워커 코어 1개
CAL_SIMPLE_RATES="1000 2000 5000 10000 20000 30000 40000 50000 60000 80000"
CAL_SIMPLE_MAX_UTIL=0.85                    # 이 이용률에 닿으면 SIMPLE 측정을 멈춤(그 이상은 대기가 섞임)
CAL_COMPLEX_RATE=30                         # COMPLEX 측정 도착률(이용률 약 0.3)
CAL_COMPLEX_CONNS=500
CAL_REACTOR_RATES="20000 30000 40000 50000 60000 70000 80000 90000 100000 120000 140000"
CAL_REACTOR_ENV=""                          # 리액터 측정 때 추가 서버 env (기본: SCALING=fixed, 워커 3코어)
CAL_REST_P99_MS=5                           # 통과: 응답 지연 − 큐 대기 − 처리 의 p99 (대기 목표 50ms 의 10%)
CAL_GENLAG_P99_MS=2                         # 생성기 송신 지연 p99 가 이보다 크면 생성기 포화로 판정
CAL_REACTOR_OK_FRAC=0.999
CAL_WARMUP=5
CAL_DURATION=20

# ── 실험 A: 지금 서버 ───────────────────────────────────────────────────
REPS_A=3
A_RHOS="0.5 0.8"                            # 1코어 기준 이용률
A_SHARES="0 0.5 0.9"                        # COMPLEX 가 차지하는 CPU 비율
A_SYNCS="0 0.05 0.2 1.0"                    # 같은 시점에 몰리는 연결 비율
A_SERVER_ENV="POOL_PROFILE=legacy WORKER_CPUS=1"

# ── 실험 B: 비용 비교 ───────────────────────────────────────────────────
REPS_B=5
B_RHO=0.8
B_LOADS="0.9:0.2 0.9:1.0"                   # COMPLEX CPU 비율:몰림. "0.5:0.2" 를 더하면 설계 예측표 첫 줄도 잰다(+20회)
B_CONFIGS="legacy dyncap1 fixed3 adaptive"
B_ENV_legacy="POOL_PROFILE=legacy WORKER_CPUS=1"
B_ENV_dyncap1="POOL_PROFILE=legacy CAP_MODE=dynamic WORKER_CPUS=1"
B_ENV_fixed3="SCALING=fixed WORKERS=3"
B_ENV_adaptive=""

# ── 실험 C: Erlang C 검증 ───────────────────────────────────────────────
REPS_C=5
C_RATES="50 150 200"                        # COMPLEX 도착률(/s)
C_THREADS="1 2 3"
C_CONNS=500                                 # 도착률이 낮아 2만 연결이면 연결당 간격이 서버 유휴 정리(90초)를 넘는다
C_SERVER_ENV="CAP_MODE=fixed QUEUE_CAP=1000000"   # 상한으로 버리지 않게 해 M/M/c 그대로 잰다

# ── 실험 D: 외부 API 분리 ───────────────────────────────────────────────
REPS_D=5
D_RATE=4000                                 # v4 10만 명의 조회율
D_ROUTERS="sync async"
D_CONNS=20000
D_WARMUP=5                                  # 첫 캐시 채움(콜드 스타트)은 측정에서 뺀다
D_DURATION=130                              # 캐시 TTL 60초 만료 두 번 포함
D_SERVER_ENV="FAKE_API_MS=100 SCALING=fixed WORKERS=1 WORKER_CPUS=1 CAP_MODE=fixed QUEUE_CAP=10000"
D_SPIKE_MS=50                               # 보고서: 100ms 칸 최대 지연이 이 값을 넘으면 튐
